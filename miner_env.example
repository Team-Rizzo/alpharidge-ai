# API that receives signed claims
MINER_API_URL=https://api.alpharidge.ai
BATCH_HTTP_TIMEOUT=30.0

# Reference miner
# JSON list of feeds and listing pages; empty uses the bundled sample
MINER_FEEDS=
MINER_CATEGORIES=finance
MINER_POLL_SECONDS=300
MINER_MAX_AGE_H=48
# Contact URL or email for the AlphaRidgeBot user agent
USER_AGENT_CONTACT=https://example.org/contact
# Full user agent override; empty uses AlphaRidgeBot/<version> (+USER_AGENT_CONTACT)
MINER_USER_AGENT=
MINER_DOMAIN_RPS=0.5
# MINER_FETCH_TIMEOUT_S=10
# Connect to public addresses only; keep true
# MINER_FETCH_PUBLIC_ONLY=true
# Feed items read per pass, open claims polled per pass, lead sentences read per page
# MINER_ITEMS_PER_TICK=40
# MINER_STATUS_PER_TICK=50
# MINER_LEAD_SENTENCES=6
# SQLite state; empty keeps it under the neuron's log directory
MINER_STATE_PATH=
