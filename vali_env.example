# Your judge API key (listed validators). Everything else below has a working default.
API_KEY=

# Coordination API
MINER_API_URL=https://api.alpharidge.ai
# HTTP timeout in seconds for API requests
BATCH_HTTP_TIMEOUT=30.0
# Seconds between validator loop passes
VALIDATION_POLL_SECONDS=10

# Daily judge spend cap in USD; pulling pauses until 00:00 UTC once it is reached
# EL_JUDGE_DAILY_CAP_USD=10

# Private sample key; generated and kept in alpharidge_ai/.audit_key when unset
# AUDIT_KEY=

# --- Served by the API ---
# The judge endpoint and model, the crawler contact, fetch timeouts and scan/judge intervals
# come from the API (/config/subnet) and refresh hourly, so you normally set none of them.
# To pin one locally, set OVERRIDE_<KEY>, e.g.:
# OVERRIDE_REVERIFY_FETCH_TIMEOUT_S=15

# Re-check fetches
# REVERIFY_CONCURRENCY=4
# REVERIFY_FETCH_RETRY=1
# Connect to public addresses only; false is refused outside --mock and local chains
# REVERIFY_FETCH_PUBLIC_ONLY=true

# Capacity and the ledger window come from the signed mechanism profile.
# The open categories need no setting.
